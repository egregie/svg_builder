{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObjectPassport",
  "type": "object",
  "required": [
    "passport_id",
    "source_file",
    "resolution",
    "complexity",
    "layers"
  ],
  "properties": {
    "passport_id": {
      "type": "string",
      "pattern": "^COMP-[0-9]{3,6}$",
      "description": "Канонический ID паспорта. Формат: COMP-NNN."
    },
    "source_file": {
      "type": "string"
    },
    "resolution": {
      "type": "object",
      "required": [
        "width_px",
        "height_px"
      ],
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "complexity": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ]
    },
    "provenance": {
      "type": "string"
    },
    "input_type": {
      "type": "string",
      "enum": [
        "HUMAN_PHOTO", "OBJECT_PHOTO", "LOGO", "ICON",
        "ILLUSTRATION", "PACKAGE_DESIGN", "TECHNICAL_GRAPHIC"
      ],
      "description": "Класс изображения (A07 classify.py). TZ v3.1."
    },
    "render_mode": {
      "type": "string",
      "enum": ["SKETCH_VECTOR", "STANDARD_VECTOR"],
      "description": "Режим рендера: скетч-линии или монохромная заливка."
    },
    "vector_detail_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "ULTRA"]
    },
    "source_width": { "type": "integer", "minimum": 1 },
    "source_height": { "type": "integer", "minimum": 1 },
    "aspect_ratio": { "type": "string" },
    "target_canvas": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "preserve_aspect_ratio": { "type": "boolean" },
    "is_tonal": { "type": "boolean" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layer_index",
          "geometry_type",
          "engine",
          "color_token"
        ],
        "properties": {
          "layer_index": {
            "type": "integer",
            "minimum": 1
          },
          "geometry_type": {
            "type": "string",
            "enum": [
              "BoundingRect",
              "CompoundPath",
              "SimplePath",
              "BezierCurve",
              "TextLayer",
              "GradientMesh",
              "ClipMask"
            ]
          },
          "engine": {
            "type": "string",
            "enum": [
              "VTracer",
              "StarVector",
              "OpenCV+VTracer",
              "OpenCV+StarVector"
            ]
          },
          "color_token": {
            "type": "string",
            "pattern": "^--[a-z][a-z0-9-]*$",
            "description": "CSS-переменная из design-tokens.json. HEX-код запрещен."
          },
          "anchor_points_limit": {
            "type": "integer",
            "maximum": 45,
            "description": "Правило атомарности. Обязательно для geometry_type: BezierCurve / CompoundPath."
          },
          "vtracer_params": {
            "type": "object",
            "description": "Передается только если engine = VTracer.",
            "properties": {
              "corner_threshold": {
                "type": "number"
              },
              "length_threshold": {
                "type": "number"
              },
              "filter_speckle": {
                "type": "integer"
              }
            }
          },
          "bounding_box": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x_min, y_min, x_max, y_max]"
          }
        }
      }
    },
    "automation_meta": {
      "type": "object",
      "properties": {
        "deconstruction_status": {
          "type": "string",
          "enum": [
            "Pending",
            "InProgress",
            "Verified",
            "Failed"
          ]
        },
        "export_path": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        }
      }
    }
  }
}
